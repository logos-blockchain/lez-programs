{
  "version": "2",
  "name": "amm",
  "messages": [
    {
      "name": "Initialize",
      "tag": 0,
      "docs": "Sent to the authorized namespace owner's actor. Creates the config PDA derived\nfrom that owner and `nonce`; deployment ids and fees are immutable afterward.",
      "fields": [
        {
          "name": "nonce",
          "type": {
            "array": [
              "u8",
              32
            ]
          }
        },
        {
          "name": "config",
          "type": {
            "defined": "AmmConfig"
          }
        }
      ]
    },
    {
      "name": "UpdateConfig",
      "tag": 1,
      "docs": "Sent to the authorized current admin's actor, which forwards to `config`.",
      "fields": [
        {
          "name": "config",
          "type": "account_id"
        },
        {
          "name": "new_authority",
          "type": "account_id"
        }
      ]
    },
    {
      "name": "NewDefinition",
      "tag": 2,
      "docs": "Sent to `config`, which admits the derived pool with its PDA seed. Both deposit\nholdings and the fresh LP holding authorize; the permanent minimum LP lock is\ndeducted from the initial supply before the transaction finishes.",
      "fields": [
        {
          "name": "config",
          "type": "account_id"
        },
        {
          "name": "definition_token_a_id",
          "type": "account_id"
        },
        {
          "name": "definition_token_b_id",
          "type": "account_id"
        },
        {
          "name": "user_holding_a",
          "type": "account_id"
        },
        {
          "name": "user_holding_b",
          "type": "account_id"
        },
        {
          "name": "user_holding_lp",
          "type": "account_id"
        },
        {
          "name": "token_a_amount",
          "type": "u128"
        },
        {
          "name": "token_b_amount",
          "type": "u128"
        },
        {
          "name": "deadline",
          "type": "u64",
          "docs": "Last valid block timestamp in milliseconds (inclusive)."
        }
      ]
    },
    {
      "name": "AddLiquidity",
      "tag": 3,
      "docs": "Both deposit holdings authorize. The existing LP holding receives minted LPs.",
      "fields": [
        {
          "name": "user_holding_a",
          "type": "account_id"
        },
        {
          "name": "user_holding_b",
          "type": "account_id"
        },
        {
          "name": "user_holding_lp",
          "type": "account_id"
        },
