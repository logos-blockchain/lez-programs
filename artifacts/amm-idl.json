          "type": "u128"
        },
        {
          "name": "deadline",
          "type": "u64"
        }
      ]
    },
    {
      "name": "SwapExactInput",
      "tag": 5,
      "docs": "The input holding authorizes. Its token definition selects the direction.",
      "fields": [
        {
          "name": "user_input_holding",
          "type": "account_id"
        },
        {
          "name": "user_output_holding",
          "type": "account_id"
        },
        {
          "name": "swap_amount_in",
          "type": "u128"
        },
        {
          "name": "min_amount_out",
          "type": "u128"
        },
        {
          "name": "deadline",
          "type": "u64"
        }
      ]
    },
    {
      "name": "SwapExactOutput",
      "tag": 6,
