          "name": "window_duration",
          "type": "u64"
        }
      ]
    },
    {
      "name": "WithdrawProtocolFees",
      "tag": 10,
      "docs": "Sent to the authorized current admin's actor. The source is derived from\n`(config, token)`; `destination` must already hold that token.",
      "fields": [
        {
          "name": "config",
          "type": "account_id"
        },
        {
          "name": "token",
          "type": "account_id"
        },
        {
          "name": "destination",
          "type": "account_id"
        },
        {
          "name": "amount",
          "type": "u128"
        }
      ]
    },
    {
      "name": "ReadState",
      "tag": 11,
      "docs": "Reply to the sender with a `lee_core::program::StateReply`. Busy actors reject reads."
    }
  ],
  "state": {
    "defined": "AmmState"
