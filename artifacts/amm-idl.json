        },
        {
          "name": "max_amount_in",
          "type": "u128"
        },
        {
          "name": "deadline",
          "type": "u64"
        }
      ]
    },
    {
      "name": "SyncReserves",
      "tag": 7,
      "docs": "Permissionless: incorporate direct vault donations into reserves and notify the oracle."
    },
    {
      "name": "CreatePriceObservations",
      "tag": 8,
      "fields": [
        {
          "name": "window_duration",
          "type": "u64"
        }
