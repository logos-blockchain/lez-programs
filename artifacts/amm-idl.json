          "name": "min_amount_liquidity",
          "type": "u128"
        },
        {
          "name": "max_amount_to_add_token_a",
          "type": "u128"
        },
        {
          "name": "max_amount_to_add_token_b",
          "type": "u128"
        },
        {
          "name": "deadline",
          "type": "u64"
        }
      ]
    },
    {
      "name": "RemoveLiquidity",
      "tag": 4,
      "docs": "The LP holding authorizes its burn; the two output holdings only receive.",
      "fields": [
        {
          "name": "user_holding_a",
          "type": "account_id"
        },
        {
          "name": "user_holding_b",
          "type": "account_id"
