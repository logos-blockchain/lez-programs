    {
      "name": "Position",
      "kind": "struct",
      "fields": [
        {
          "name": "token_program_id",
          "type": "account_id",
          "docs": "The token program the vault lives in, pinned when the position opened."
        },
        {
          "name": "collateral_definition_id",
          "type": "account_id",
          "docs": "The collateral token's definition, pinned when the position opened. A deposit\ninitializes the vault's holding of it, which pins the vault into the transaction."
        },
        {
          "name": "collateral_amount",
          "type": "u128",
          "docs": "Collateral held in the position's vault, in raw collateral units."
        },
        {
          "name": "normalized_debt_amount",
          "type": "u128",
          "docs": "Debt divided by the stability fee accumulator at the time it was taken, so the debt\ngrows with the accumulator without touching the position."
        }
      ]
    },
    {
      "name": "PositionClosed",
      "kind": "struct",
      "fields": [
        {
          "name": "owner",
          "type": "account_id"
        }
      ]
    },
    {
      "name": "PositionOpened",
      "kind": "struct",
      "fields": [
        {
          "name": "owner",
          "type": "account_id"
        },
        {
          "name": "vault",
          "type": "account_id"
        },
        {
          "name": "collateral_amount",
          "type": "u128"
        }
      ]
    },
    {
      "name": "ProtocolParameters",
      "kind": "struct",
      "fields": [
        {
          "name": "admin_account_id",
          "type": "account_id",
          "docs": "Authority required for every parameter-update and admin-rotation action."
        },
        {
          "name": "freeze_authority_account_id",
          "type": "account_id",
          "docs": "Authority required for `Freeze` / `Unfreeze`."
        },
        {
          "name": "token_program_id",
          "type": "account_id",
          "docs": "The token program every stablecoin and collateral token lives in. IMMUTABLE."
        },
        {
          "name": "stablecoin_definition_id",
          "type": "account_id",
          "docs": "The stablecoin's token definition PDA. IMMUTABLE: changing it would break supply\naccounting against the existing float."
        },
        {
          "name": "collateral_definition_id",
          "type": "account_id",
          "docs": "The single accepted collateral's token definition. IMMUTABLE: changing it would orphan\nevery position vault."
        },
        {
          "name": "market_price_oracle_id",
          "type": "account_id",
          "docs": "Address of the market price oracle's price actor used by the controller."
        },
        {
          "name": "market_price_oracle_program_id",
          "type": "account_id",
          "docs": "The program the bound oracle's price actor must belong to. Set with its address by the\nadmin, including when the oracle does not exist yet."
        },
        {
          "name": "stability_fee_per_millisecond",
          "type": "u128",
          "docs": "Per-millisecond stability fee multiplier in fixed-point, stored as\n`(1 + r_per_millisecond) * FIXED_POINT_ONE`."
        },
        {
          "name": "controller_proportional_gain",
          "type": "i128",
          "docs": "PI controller `Kp`. Signed."
        },
        {
          "name": "controller_integral_gain",
          "type": "i128",
          "docs": "PI controller `Ki`. Signed."
        },
        {
          "name": "minimum_collateralization_ratio",
          "type": "u128",
          "docs": "Minimum collateralization ratio in fixed-point (`1.5 * FIXED_POINT_ONE` = 150%)."
        },
        {
          "name": "minimum_milliseconds_between_rate_updates",
          "type": "u64",
          "docs": "Minimum milliseconds between successful `UpdateRedemptionRate` calls."
        },
        {
          "name": "maximum_oracle_price_age_milliseconds",
          "type": "u64",
          "docs": "Reject oracle observations older than this."
        },
        {
          "name": "is_frozen",
          "type": "bool",
          "docs": "`true` blocks `OpenPosition`, `GenerateDebt`, and `WithdrawCollateral` for positions\nwith nonzero normalized debt. Debt-free withdrawals remain allowed."
        },
        {
          "name": "minimum_debt_amount",
          "type": "u128",
          "docs": "Minimum positive accrued position debt, in raw stablecoin atomic units."
        },
        {
          "name": "debt_ceiling",
          "type": "u128",
          "docs": "Aggregate accrued debt ceiling for new borrowing, in raw atomic units."
        }
      ]
    },
    {
      "name": "RedemptionPriceState",
      "kind": "struct",
      "fields": [
        {
          "name": "redemption_price_at_last_update",
          "type": "u128",
          "docs": "Redemption price at [`Self::last_updated_at`], collateral-per-stablecoin\nfixed-point."
        },
        {
          "name": "redemption_rate_per_millisecond",
          "type": "u128",
          "docs": "Per-millisecond drift multiplier, fixed-point. Below `FIXED_POINT_ONE` means\ndecay; above means growth."
        },
        {
          "name": "controller_integral_term",
          "type": "i128",
          "docs": "Persisted PI integral state, signed. Clamped against windup on every\n`update_redemption_rate` (anti-windup bounds live in code constants in\nv1; see spec §8)."
        },
        {
          "name": "last_updated_at",
          "type": "u64",
          "docs": "Unix milliseconds of the last `update_redemption_rate` call (or of\n`initialize_program`, for the initial state)."
        }
      ]
    },
    {
      "name": "RedemptionRateUpdated",
      "kind": "struct",
      "fields": [
        {
          "name": "redemption_price",
          "type": "u128"
        },
        {
          "name": "redemption_rate_per_millisecond",
          "type": "u128"
        },
        {
          "name": "now",
          "type": "u64"
        }
      ]
    },
    {
      "name": "StabilityFeeAccrued",
      "kind": "struct",
      "fields": [
        {
          "name": "accumulated_rate",
          "type": "u128"
        },
        {
          "name": "accrued_fees",
          "type": "u128"
        },
        {
          "name": "now",
          "type": "u64"
        }
      ]
    },
    {
      "name": "StabilityFeeAccumulator",
      "kind": "struct",
      "fields": [
        {
          "name": "accumulated_rate_at_last_accrual",
          "type": "u128",
          "docs": "Accumulator value at [`Self::last_accrued_at`], fixed-point. Initialized\nto `FIXED_POINT_ONE` and monotonically non-decreasing."
        },
        {
          "name": "last_accrued_at",
          "type": "u64",
          "docs": "Unix milliseconds of the last accrual."
        },
        {
          "name": "total_normalized_debt",
          "type": "u128",
          "docs": "Sum of every position's `normalized_debt_amount` (RAI's `debtAmount`).\n\nEach accrual mints `total_normalized_debt × Δaccumulator / FIXED_POINT_ONE`\nstablecoin to the protocol's surplus holding, so the supply keeps pace with\nthe total nominal debt (spec §6.6, RFP R1). `generate_debt` and\n`repay_debt` keep it in step with the positions."
        }
      ]
    },
    {
      "name": "StablecoinState",
      "kind": "enum",
      "variants": [
        {
          "name": "Engine",
          "fields": [
            {
              "name": "0",
              "type": {
                "defined": "Engine"
              }
            }
          ]
        },
        {
          "name": "Position",
          "fields": [
            {
              "name": "0",
              "type": {
                "defined": "Position"
              }
            }
          ]
        }
      ]
    }
  ]
}
