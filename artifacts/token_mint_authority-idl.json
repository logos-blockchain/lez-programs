  "version": "2",
  "name": "token_mint_authority",
  "messages": [
    {
      "name": "FaucetMint",
      "tag": 0,
      "docs": "Claim a fixed grant for the holding at `to`. The claimant must authorize the call.\nAn empty holding also requires its account's authorization. An existing holding\nmust belong to `definition` in `token_program_id`.\n\nInclude the claimant, allowance PDA and destination under the faucet program,\nthe mint authority PDA, definition and destination under the token program,\nand the system clock actor. The allowance reads the clock. The destination\nasks the token program to mint and checks that the credit settled. A private\ndestination must promote the token credit within the transaction.",
      "fields": [
        {
          "name": "token_program_id",
          "type": "account_id"
        },
        {
          "name": "definition",
          "type": "account_id"
        },
        {
          "name": "to",
          "type": "account_id"
        }
      ]
    }
  ],
