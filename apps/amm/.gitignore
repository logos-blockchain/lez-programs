tests/testnet/stablecoin.json

# Stablecoin deployment manifest (program ids + accounts) for a local or testnet run
tests/testnet/stablecoin.json

# Custom token picked for tests/e2e/custom-token.mjs
tests/testnet/custom-token-manifest.json
